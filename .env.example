# Copy to .env.local and fill in. All variables are optional in development.

# Absolute site URL used for canonical/hreflang/sitemap. Keep without trailing slash.
NEXT_PUBLIC_SITE_URL=https://dogubaticenaze.com

# --- Contact form delivery (Resend, https://resend.com) ---
# Without RESEND_API_KEY the form only logs to the server console.
RESEND_API_KEY=
CONTACT_TO_EMAIL=info@dogubaticenaze.com
CONTACT_FROM_EMAIL="Web Formu <form@dogubaticenaze.com>"

# --- Cloudflare Turnstile (free bot protection) ---
# Leave both empty to disable the widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Cookieless analytics (Plausible). Loaded only after the visitor accepts "measurement" cookies. ---
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js
